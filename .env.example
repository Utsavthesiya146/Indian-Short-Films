# Supabase Configuration for Indian Short Films Platform
# Obtain credentials from Supabase Dashboard -> Project Settings -> API

# Public Supabase URL (Used by Next.js Web App & Flutter Mobile App)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# Public Publishable / Anon Key (Safe for browser & Flutter application bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Secret Service Role Key (STRICTLY SERVER-ONLY - NEVER expose to browser or client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

